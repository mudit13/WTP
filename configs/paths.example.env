# Copy to configs/paths.env, edit for the target machine, and never commit paths.env.
# Values should be concrete absolute paths. Avoid nested ${WTP_ROOT} references because
# some project code reads this file directly rather than through a shell.

# Repository and project root
WTP_ROOT=/pitsec_sose26_topic8

# External dataset root
WTP_DFFD_DIR=/share/DeepFake/DFFD_Images

# Python interpreters
# SD1.5 generation and DE-FAKE/analysis intentionally use the same environment.
WTP_PY_SD15=/pitsec_sose26_topic8/venv_sd15/bin/python3
WTP_PY_DEFAKE=/pitsec_sose26_topic8/venv_sd15/bin/python3
WTP_PY_FLUX1=/pitsec_sose26_topic8/venv_flux1/bin/python3
WTP_PY_STYLEGAN3=/pitsec_sose26_topic8/venv_stylegan3/bin/python3

# Supervisor-provided DE-FAKE checkpoints
WTP_DEFAKE_FINETUNE_CLIP=/pitsec_sose26_topic8/models/finetune_clip.pt
WTP_DEFAKE_CLIP_LINEAR=/pitsec_sose26_topic8/models/clip_linear.pt

# External StyleGAN3 checkout
WTP_STYLEGAN3_REPO=/pitsec_sose26_topic8/stylegan3

# Optional shared model cache override
# WTP_MODEL_CACHE=/pitsec_sose26_topic8/models

# Optional generation output overrides
# WTP_SD15_OUTPUT_DIR=/pitsec_sose26_topic8/dataset/sd15_txt2img
# WTP_FLUX1_OUTPUT_DIR=/pitsec_sose26_topic8/dataset/flux1_txt2img
# WTP_STYLEGAN3_OUTPUT_DIR=/pitsec_sose26_topic8/dataset/stylegan3

# Optional BLIP checkpoint URL override
# WTP_BLIP_URL=https://storage.googleapis.com/sfr-vision-language-research/BLIP/models/model_base_capfilt_large.pth

# Repository-owned defaults are derived from WTP_ROOT by the scripts:
#   De-Fake-patched/
#   dataset/master_metadata.csv
#   dataset/defake_predictions.csv
#   results/<run_id>/
#   logs/
